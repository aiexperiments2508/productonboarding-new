{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "platform",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "run.py",
        "--no-gateway"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "vendor-portal",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "apps.vendor.server"
      ],
      "port": 8110
    },
    {
      "name": "storefront",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "apps.storefront.server"
      ],
      "port": 8120
    },
    {
      "name": "ops-console",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "apps.ops.server"
      ],
      "port": 8130
    }
  ]
}
