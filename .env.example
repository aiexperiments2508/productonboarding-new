# Copy to .env and fill in.  All you must decide is which gateway to use.
#   copy .env.example .env
#
# Everything else has a working default. The switches near the bottom change
# how the system talks to itself, not what it decides - the answers are
# identical whichever way they are set, and that is deliberate.

# --- Gateway --------------------------------------------------------------
# Every model and embedding call in the system leaves through one LiteLLM
# gateway. There are two ways to have one, and you want exactly one of them.
#
# (a) ATTACH to a gateway that is already running - a shared instance, a
#     container, one started by hand. Set these two and run.py starts nothing
#     of its own. The provider credentials live in that gateway, so no
#     GEMINI_API_KEY is needed here. Models are read from its /v1/models at
#     runtime, so whatever it serves is what the UI offers and the graph uses.
LITELLM_BASE_URL=http://127.0.0.1:5000
LITELLM_API_KEY=your_gateway_master_key_here

# (b) START one from litellm/config.yaml. Comment out the two lines above,
#     uncomment these, and supply the provider key the proxy will use.
# LITELLM_HOST=127.0.0.1
# LITELLM_PORT=4010
# GEMINI_API_KEY=your_gemini_api_key_here

# Adding another provider is this file plus a model_list entry in
# litellm/config.yaml. No application code changes.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Leave unset to use the strongest model the gateway serves.
# Set it only to pin a specific alias.
# LITELLM_DEFAULT_MODEL=
LITELLM_EMBED_MODEL=gemini-embedding-001

# The graph asks for a tier - "the fast model" for extraction, triage, claim
# scanning and enrichment; "the reasoning model" for scope resolution, copy
# regeneration and the reviewer write-up. Which model fills each tier is
# normally inferred from the model names, but that only works when the names
# say something: a gateway serving five flash-class models has no readable
# reasoning tier, and everything collapses onto whichever is newest. Pin them
# when the names cannot carry the distinction. Both are validated against the
# gateway's own list at startup, so a retired alias is caught here rather than
# from inside a run.
# LITELLM_FAST_MODEL=gemini-3.5-flash-lite
# LITELLM_REASONING_MODEL=gemini-3.7-flash

# LLM response cache. 1 = serve repeat calls from SQLite (deterministic,
# fast, survives a dead network). 0 = always call live.
LLM_CACHE=1

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- the connected applications ---------------------------------------------
# Three separate processes, each on its own port, each reaching this platform
# over MCP and by no other route. `startup.bat` starts them; `startup.bat solo`
# does not. They are independent of each other and of the platform's start
# order - each dials on its first call and reconnects afterwards.
VENDOR_PORT=8110
STOREFRONT_PORT=8120
OPS_PORT=8130

# Where those applications look for this platform. Set it when the platform is
# not on 127.0.0.1:$API_PORT - they must never assume a port, because a wrong
# guess reaches whatever else is listening there and reads as this platform
# being broken.
# PLATFORM_URL=http://127.0.0.1:8000

# --- MCP ------------------------------------------------------------------
# The toolset is split into six servers by owning system (sc/mcp/), five of
# them read-only. Each runs alone: `python -m sc.mcp.supplier_network`.
#
# This switch controls how THIS process reaches them:
#   0 = call the tool functions directly, in-process
#   1 = spawn each toolset and call it over stdio, so the investigator's
#       evidence lookups become real round-trips across a protocol boundary
#
# Only read-only lookups are routed. Committing a plan over a pipe that might
# have died halfway is a worse idea than committing it in-process.
#
# Defaults to 0 because the first call to each toolset pays a subprocess spawn
# (~1.5s) and a demo should not. Flip it live from System Control - the console
# there records which path every call actually took.
USE_MCP=0

# --- A2A ------------------------------------------------------------------
# Four capabilities are published as A2A peers with discoverable Agent Cards
# (sc/a2a/): impact-analyst, recovery-planner, simulator, risk-analyst. The
# cards are served regardless of this setting - discovery and delegation are
# different things, and another organisation's agent can call these skills
# whether or not this process uses the protocol on itself.
#
#   0 = the graph calls the peer handlers in-process
#   1 = the graph delegates over JSON-RPC message/send
#
# The trace hash is identical either way. If it were not, this would be two
# implementations rather than one capability with two front doors.
USE_A2A=0

# Where the peers advertise themselves and where the graph calls them.
# Defaults to http://127.0.0.1:$API_PORT, which is right unless the app sits
# behind a proxy or the peers are moved to their own host.
# A2A_BASE_URL=http://127.0.0.1:8000

# --- Data -----------------------------------------------------------------
DATA_DIR=data
DB_PATH=data/factory.db
# Seeds the generated pack. Same seed, same catalog, same corrections.
DATA_SEED=20802

# Where the authored standards, channel specs, policies and prior incidents are
# read from. That corpus is content, not generated data, and is committed.
# CORPUS_DIR=corpus

# --- Advanced -------------------------------------------------------------
# These have working defaults and exist for the cases where the default is
# wrong. Listed because a setting the code reads and the template never
# mentions is a setting nobody knows they have.

# Browser origins allowed to call the API. The default suits a single-machine
# demo; tighten it if the API is ever exposed beyond localhost.
# CORS_ORIGIN=*

# Which file the model-selection panel writes back to.
# ENV_FILE=.env

# Ceiling on graph supersteps. The loop has one cycle - a commit that loses a
# race regenerates options - and this is what stops a pathological run from
# spinning. Raise it only if a legitimate run is being cut off.
# GRAPH_RECURSION_LIMIT=50

# --- Optional: LangGraph Studio trace persistence -------------------------
# The app runs fine without this; Approvals & Audit is the primary proof
# surface. Set it only if you want traces retained in LangSmith.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=product-intelligence-uc05
